# Copia este archivo como .env y ajústalo. Node no lo lee automáticamente:
# las variables se pasan por terminal o con un gestor como dotenv.

# Puerto del servidor web
PORT=3000

# Interfaz de escucha.
# 127.0.0.1 = solo este equipo (más seguro, es el valor por defecto)
# 0.0.0.0   = accesible desde tu red (SIN autenticación: cualquiera podría escanear)
HOST=127.0.0.1

# Timeout en ms de cada escaneo. Debe ser mayor que los --host-timeout de nmap.
NMAP_TIMEOUT=360000

# Timeout de nmap en el escaneo de puertos (suele duplicarse al usar -O)
PORT_HOST_TIMEOUT=240s
NO_OS_HOST_TIMEOUT=150s

# Timeout de nmap en el escaneo de vulnerabilidades
VULN_HOST_TIMEOUT=240s

# Scripts NSE para buscar vulnerabilidades.
# "not dos" evita payloads de denegación de servicio contra tus propios equipos.
VULN_SCRIPTS=vuln and not dos

# Solo Windows: distro de WSL donde está instalado nmap.
# WSL_DISTRO=kali-linux

# Solo Windows: poner en 0 si instalaste nmap de forma nativa en Windows.
# USE_WSL=1

# Ruta al ejecutable de nmap, si no está en el PATH.
# NMAP_BIN=/usr/bin/nmap

# Origen permitido por CORS. * permite cualquiera.
# CORS_ORIGIN=*